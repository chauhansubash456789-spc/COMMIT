# =============================================================================
# COMMIT PROTOCOL — ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port
PORT=3000

# Application Base URL & Trusted Origins (SIWS origin matching)
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://commit.fun

# Solana Cluster Configuration (Devnet / Mainnet-Beta)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Supabase PostgreSQL & Auth Credentials
# SUPABASE_URL: Your Supabase Project REST URL
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_ANON_KEY: Public anonymous key for client sessions
SUPABASE_ANON_KEY=your-anon-key

# SUPABASE_SERVICE_ROLE_KEY: Authoritative server key used for Ed25519 wallet session provisioning,
# cryptographic challenge nonces, and Oracle attestation settlements.
# (CRITICAL: NEVER EXPOSE TO CLIENT / BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional Oracle Keypair Path (defaults to server/oracle/oracle-keypair.json)
# ORACLE_KEYPAIR_PATH=./server/oracle/oracle-keypair.json